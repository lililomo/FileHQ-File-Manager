# File Manager (file.kppbwi.app) — contoh konfigurasi.
# Salin ke .env (chmod 600) lalu isi nilai CHANGE_ME. Jangan commit .env.
# Referensi lengkap setiap variabel: SPEC.md §3 (tipe, default, validasi, bisa di-override admin atau tidak).

# --- Aplikasi ---
APP_ENV=production                      # production | development
APP_BASE_URL=https://file.kppbwi.app    # origin publik, dipakai untuk link share & cookie Secure
LISTEN_ADDR=127.0.0.1:8080              # hanya loopback; Nginx aaPanel yang menghadap publik
TRUSTED_PROXIES=127.0.0.1               # daftar IP/CIDR proxy yang boleh mengirim X-Forwarded-*
LOG_LEVEL=info                          # debug | info | warn | error

# --- Storage ---
STORAGE_ROOT=/www/storage/FileManager          # root semua folder user (<STORAGE_ROOT>/<username>)
DATA_DIR=/www/storage/FileManager/.system      # DB, trash, versi, upload, thumbs, tmp, logs (harus satu filesystem dengan STORAGE_ROOT)

# --- Rahasia ---
APP_SECRET=CHANGE_ME                    # 64 hex char: openssl rand -hex 32 (dipakai untuk HMAC signed URL, cookie share, CSRF)

# --- Admin awal (hanya dipakai saat tabel user kosong) ---
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=CHANGE_ME        # sekali pakai; wajib diganti saat login pertama; hapus dari file ini setelah diganti
ADMIN_CAN_BROWSE_USERS=false            # true = admin bisa membuka folder user lain (setiap akses masuk audit log)

# --- Kuota & batas ---
DEFAULT_USER_QUOTA=10GB
MAX_UPLOAD_SIZE=20GB
UPLOAD_CHUNK_SIZE=16MB                  # client_max_body_size Nginx harus >= nilai ini
TRASH_RETENTION_DAYS=30
FILE_VERSION_LIMIT=50
EDITOR_MAX_FILE_SIZE=5MB                # di atas ini editor membuka mode tail read-only
REMOTE_DOWNLOAD_ENABLED=true
REMOTE_DOWNLOAD_MAX_SIZE=10GB
ARCHIVE_MAX_EXTRACT_SIZE=50GB
ARCHIVE_MAX_ENTRIES=200000
SHARE_DEFAULT_EXPIRY_DAYS=7

# --- Sesi ---
SESSION_IDLE_TIMEOUT=2h
SESSION_ABSOLUTE_TIMEOUT=168h

# --- Path binary CLI (dipanggil dengan argument array, tanpa shell) ---
FFMPEG_PATH=/usr/bin/ffmpeg
SEVENZIP_PATH=/usr/lib/7zip/7z        # paket Ubuntu 24.04 "7zip" memasang binary asli di /usr/lib/7zip/7z (wrapper sh: /usr/bin/7z, 7za, 7zr); binary 7zz tidak ada
RAR_PATH=                               # kosong = compress .rar nonaktif (butuh binary rar berlisensi)
UNRAR_PATH=                             # kosong = extract rar memakai library Go; isi jika unrar terpasang
RG_PATH=/usr/bin/rg

# --- Opsional (default di SPEC §3; hapus tanda # untuk mengubah) ---
# FFPROBE_PATH=/usr/bin/ffprobe
# VIPS_PATH=/usr/bin/vipsthumbnail
# PDFTOPPM_PATH=/usr/bin/pdftoppm
# THUMB_WORKERS=                        # default max(1, CPU-1)
# TASK_MAX_PER_USER=3
# LISTING_PAGE_SIZE=500
# SIGNED_URL_TTL=5m
# MEDIA_URL_TTL=2h
# AUDIT_RETENTION_DAYS=180
# ACTIVITY_RETENTION_DAYS=90
# TZ_DEFAULT=Asia/Jakarta
# METRICS_ADDR=                         # mis. 127.0.0.1:9090; kosong = metrik Prometheus nonaktif
# CONTENT_BASE_URL=                     # kosong = konten user disajikan dari origin yang sama (SPEC ADR-06)
# TASK_MAX_GLOBAL=                      # default max(2, 2*CPU)
# BLOCKED_EXTENSIONS=                   # mis. exe,bat,cmd — ekstensi tanpa titik, dipisah koma (bisa diubah admin)
# PUBLIC_SHARES_ENABLED=true
# SHARE_ALLOW_NO_EXPIRY=true
# SHARE_REQUIRE_PASSWORD=false
# PASSWORD_MIN_LENGTH=12
# APP_NAME=FileManager
# DEFAULT_LANGUAGE=id                   # id | en
